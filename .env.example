NEXT_PUBLIC_SITE_URL=https://www.intelicrop.com

# Optional. Endpoint the contact form POSTs to (JSON). Configure it to deliver to
# comercial@intelicrop.com, e.g. a Formspree form (https://formspree.io/f/xxxxxxx)
# or FormSubmit (https://formsubmit.co/ajax/comercial@intelicrop.com).
